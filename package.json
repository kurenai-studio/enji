{
  "name": "@kurenai-studio/enji",
  "version": "0.3.0",
  "description": "Enji — Creator 3.8 preview/edit workflow (no publish). Bundles a trimmed cocos runtime with 3.8 meta caps.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "bin": {
    "enji": "bin/enji.mjs"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*",
    "bin/**/*",
    "host/**/*",
    "vendor/cocos-core/**/*",
    "scripts/install-cocos-deps.mjs",
    "templates/**/*",
    "docs/**/*",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "check": "tsc --noEmit && npm run build && npm run test",
    "postinstall": "node scripts/install-cocos-deps.mjs",
    "vendor:cocos": "node scripts/vendor-cocos-core.mjs"
  },
  "keywords": [
    "cocos",
    "enji",
    "creator-3.8",
    "preview"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22"
  }
}
